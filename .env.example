# Copy this file to `.env.local` and adjust the values.
# Never commit `.env.local` – it is listed in .gitignore.

# Public URL of the website (used for canonical links, sitemap.xml and robots.txt).
# Example: https://www.randa-paralegal.ch
# If unset, the Vercel production domain (VERCEL_PROJECT_PRODUCTION_URL) is used, locally http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reserved for the later backend phase (NOT used yet) ---------------------
# The intake form currently runs in demo mode: nothing is sent, stored or booked.
# The following variables will be needed once the backend is approved:
# EMAIL_PROVIDER_API_KEY=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# DATABASE_URL=
# STORAGE_BUCKET=
