# Copy this file to `.env.local` and adjust the values.
# Never commit `.env.local` – it is listed in .gitignore.

# Public URL of the website (used for canonical links, sitemap.xml and robots.txt).
# Example: https://www.randa-paralegalservices.ch
# If unset, the Vercel production domain (VERCEL_PROJECT_PRODUCTION_URL) is used, locally http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Intake form e-mails (Resend, https://resend.com) ------------------------
# Required: API key of a Resend account whose sending domain is verified.
RESEND_API_KEY=
# Optional: sender address (must use the verified domain).
# Default: Randa Paralegal Services <anfrage@randa-paralegalservices.ch>
# MAIL_FROM=
# Optional: inbox for new requests. Default: contact.email in src/config/site.ts
# MAIL_TO=

# --- Reserved for a later phase (NOT used yet) ---------------------------------
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# STORAGE_BUCKET=
